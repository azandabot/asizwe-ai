# =============================================================================
# AsizweAI Chrome Extension - .gitignore
# =============================================================================

# -----------------------------------------------------------------------------
# Environment & Secrets
# -----------------------------------------------------------------------------
.env
.env.local
.env.development
.env.production
.env*.local
*.pem
*.key
secrets.json
credentials.json
api-keys.json

# -----------------------------------------------------------------------------
# Dependencies
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
package-lock.json
yarn.lock
pnpm-lock.yaml

# -----------------------------------------------------------------------------
# Build Outputs
# -----------------------------------------------------------------------------
dist/
build/
out/
*.zip
*.crx
*.xpi
web-ext-artifacts/

# -----------------------------------------------------------------------------
# Chrome Extension Specific
# -----------------------------------------------------------------------------
# Packed extension files
*.pem
key.pem

# Chrome extension package
extension.zip
asizwe-ai.zip
asizwe-ai.crx

# Temporary files created during development
_metadata/

# -----------------------------------------------------------------------------
# IDE & Editor
# -----------------------------------------------------------------------------
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# -----------------------------------------------------------------------------
# Operating System
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items
.apdisk

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Testing & Coverage
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
*.lcov
.coverage
htmlcov/
jest-results/
test-results/

# -----------------------------------------------------------------------------
# Logs & Debug
# -----------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
debug.log

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Temporary files
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# Cache files
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Documentation build
docs/_build/
site/

# Local development
.local/
local/

# Compressed files (except intentional assets)
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.tgz

# -----------------------------------------------------------------------------
# Project Specific
# -----------------------------------------------------------------------------
# Local configuration overrides
config.local.js
settings.local.json

# Development scripts
scripts/local/
dev-tools/

# Screenshots and recordings (large files)
screenshots/
recordings/
*.mp4
*.mov
*.avi
*.gif

# Keep placeholder for assets
!assets/icons/*.png
!assets/images/.gitkeep
