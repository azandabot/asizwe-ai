{
  "manifest_version": 3,
  "name": "AsizweAI",
  "version": "1.0.0",
  "description": "Let Us Hear — Real-time audio translation for any language",
  "permissions": [
    "tabCapture",
    "activeTab",
    "tabs",
    "storage",
    "offscreen"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/audio-processor.js"],
      "matches": ["<all_urls>"],
      "extension_ids": []
    }
  ]
}
